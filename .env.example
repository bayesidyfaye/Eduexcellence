# GEMINI_API_KEY: Fallback for development AI calls when NVIDIA NIM is offline
# Users configure this via the Secrets panel in AI Studio UI
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NVIDIA NIM / Brev Settings (Primary inference engine on NVIDIA GPU)
# Hackathon participants get free NVIDIA Brev credits to run Brev GPU instances
# Example Brev local tunnel: "http://localhost:8000/v1" or Brev domain: "https://<brev-instance>-8000.brev.dev/v1"
# Or NVIDIA Build API endpoint: "https://integrate.api.nvidia.com/v1"
NVIDIA_NIM_ENDPOINT="https://integrate.api.nvidia.com/v1"
NVIDIA_API_KEY="nvapi-YOUR_NVIDIA_NGC_OR_BREV_KEY"
NVIDIA_MODEL="meta/llama-3.1-8b-instruct"

# NVIDIA Brev instance identifier (shown in Brev console)
BREV_INSTANCE_ID="brev-edu-l4-gpu-01"
BREV_GPU_TYPE="NVIDIA L4 (24GB VRAM) / Brev Cloud GPU"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"
